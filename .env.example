NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:local-development-only@127.0.0.1:15455/telegram_job_alerts_test
EXPECTED_DATABASE=telegram_job_alerts_test

# Optional: only this numeric Telegram user ID can run /stats; excluded from statistics.
# Leave unset to disable /stats. No additional secret is required.
# ADMIN_TELEGRAM_ID=123456789
BOT_TOKEN=
WEBHOOK_URL=https://gelatoni.uk/bots/telegram-job-alerts/webhook
WEBHOOK_SECRET=
SOURCE_SYNC_ENABLED=false
SCHEDULER_ENABLED=false
DELIVERY_ENABLED=false
DATABASE_POOL_MAX=3
DELETION_JOURNAL_PATH=.secrets/deletions.jsonl
